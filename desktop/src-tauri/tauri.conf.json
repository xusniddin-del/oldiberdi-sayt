{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oldi-Berdi",
  "version": "1.1.1",
  "identifier": "uz.oldiberdi.desktop",
  "build": { "frontendDist": "../web" },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "publisher": "Oldi-Berdi",
    "copyright": "© Oldi-Berdi",
    "category": "Finance",
    "shortDescription": "Qarz daftari",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["English", "Russian"], "displayLanguageSelector": false }
    },
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
